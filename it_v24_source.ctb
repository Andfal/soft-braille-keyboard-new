# Tabella IBRIDA Italiana v21 (OMNIA - 100%)
include unicode.dis

include latinLetterDef6Dots.uti

# Italian standard accented
lowercase \x00E0 12356                                # a with grave
base uppercase \x00C0 \x00E0
lowercase \x00E8 2346                         # e with grave
base uppercase \x00C8 \x00E8
lowercase \x00E9 123456                               # e with acute
base uppercase \x00C9 \x00E9
lowercase \x00EC 34                           # i with grave above
base uppercase \x00CC \x00EC
lowercase \x00F2 346                  # o with grave above
base uppercase \x00D2 \x00F2
lowercase \x00F9 23456                        # u with grave above
base uppercase \x00D9 \x00F9

# Circonflesse
lowercase \x00E2 5-16                         a accent circonflexe
base uppercase \x00C2 \x00E2
lowercase \x00EA 5-126                        e accent circonflexe
base uppercase \x00CA \x00EA
lowercase \x00EE 5-146                        i accent circonflexe
base uppercase \x00CE \x00EE
lowercase \x00F4 5-1456                       o accent circonflexe
base uppercase \x00D4 \x00F4
lowercase \x00FB 5-156                        u accent circonflexe
base uppercase \x00DB \x00FB
# Dieresi
lowercase \x00E4 6-345         A with diaeresis
base uppercase \x00C4 \x00E4
lowercase \x00EB 5-1246                       e tréma
base uppercase \x00CB \x00EB
lowercase \x00EF 5-12456               i tréma
base uppercase \x00CF \x00EF
lowercase \x00F6 6-246                        # o with diaeresis
base uppercase \x00D6 \x00F6
lowercase \x00FC 5-1256                       u tréma
base uppercase \x00DC \x00FC

# Acute
lowercase \x00E1 6-12356        A with acute
base uppercase \x00C1 \x00E1
lowercase \x00ED 6-34          i with acute
base uppercase \x00CD \x00ED
lowercase \x00F3 6-346         o with acute
base uppercase \x00D3 \x00F3
lowercase \x00FA 6-23456        U with acute
base uppercase \x00DA \x00FA
lowercase \x00FD 5-2456   #y with acute
base uppercase \x00DD \x00FD

# Others
lowercase \x0153 5-246    oe liés
base uppercase \x0152 \x0153
lowercase \x00F1 6-12456     n tilde
base uppercase \x00D1 \x00F1
lowercase \x00E7 6-12346              c cédille
base uppercase \x00C7 \x00E7
# Schwa (Əə)
lowercase \x0259 6-16                         schwa
base uppercase \x018F \x0259

punctuation \x0021 235    # !
punctuation \x0022 4      # "
punctuation \x0027 3      # '
punctuation \x0028 236    # (
punctuation \x0029 356    # )
punctuation \x002C 2      # ,
punctuation \x002E 256    # .
punctuation \x003A 25     # :
punctuation \x003B 23     # ;
punctuation \x003F 26     # ?
punctuation \x002D 36     # -
punctuation \x002A 35     # * (Aggiunto)
punctuation \x005B 5-12356 # [
punctuation \x005D 5-23456 # ]
punctuation \x007B 5-12346 # {
punctuation \x007D 5-13456 # }
punctuation \x00AB 5-236   # «
punctuation \x00BB 5-356   # »
punctuation \x00A1 6-235   # ¡
punctuation \x00BF 6-26    # ¿
punctuation \x00B7 6-3     # ·

sign \x0040 345           # @
sign \x0023 5-3456        # #
sign \x0024 5-46          # $
sign \x0025 5-123456      # %
sign \x0026 12346         # &
sign \x002B 5-235         # +
sign \x002F 5-256         # /
sign \x005C 56-6          # \
sign \x005E 45-2346       # ^
sign \x005F 456           # _
sign \x007E 5-2346        # ~
sign \x007C 5-34          # |
sign \x0060 5-345         # `
sign \x20AC 5-15          # €
sign \x00A2 5-14          # ¢
sign \x00A3 5-123         # £
sign \x00A4 6-15          # ¤
sign \x00A5 6-13456       # ¥
sign \x00A7 5-346         # §
sign \x00A9 6-14          # ©
sign \x00AE 5-1235        # ®
sign \x2122 5-2345        # ™
sign \x00B0 6-135         # °
sign \x00B1 45-235        # ±
sign \x00B4 6-1256        # ´
sign \x00B5 5-134         # µ
sign \x00AF 6-134         # ¯
sign \x00A8 5-4           # ¨ (Aggiunto)
sign \x00AA 5-1           # ª
sign \x00BA 5-135         # º
sign \x2022 5-35          # •
sign \x2026 3-3-3         # …
sign \x2030 3456-13456    # ‰
sign \x2013 6-256         # –
sign \x2014 5-36          # —
sign \x2018 5-3           # ‘
sign \x2019 5-6           # ’
sign \x201C 6-236         # “
