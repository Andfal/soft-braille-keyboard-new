sign \x00BD 3456-2-12     # 1/2
sign \x00BE 3456-25-145   # 3/4

math \x003C 56            # <
math \x003D 2356          # =
math \x003E 45            # >
math \x00D7 46-236        # ×
math \x00F7 46-256        # ÷

numsign 3456
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

midnum \x002C 2
midnum \x002E 256
midnum \x003A 25
midnum \x002D 36
numericmodechars ,.:-

always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246
always \x0030 6-3456

capsletter 46
begcapsword 46-46
endcapsword 46-3
space \x0020 0
space \x00a0 5
space \x0009 5-5

include braille-patterns.cti
