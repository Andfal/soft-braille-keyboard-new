# Custom Table for Soft Braille Keyboard
# Dots: 6
#+locale: it

include braille-patterns.cti
include unicode.dis

# --- HIGH PRIORITY CUSTOM MAPPINGS ---
numsign 3456
capsletter 46
begcapsword 46-46
space \x0020 0

# --- SYSTEM INCLUDES ---
include unicode.dis
include latinLetterDef6Dots.uti
include digits6Dots.uti
include litdigits6Dots.uti
numsign 3456

# --- STANDARD PRIORITY CUSTOM MAPPINGS ---
