# Tabella di test RIFINITA v6 (Configurazione Standard Liblouis)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# Lettere
include latinLetterDef6Dots.uti

# Sistema Segnanumero 
numsign 3456
# Mappatura numeri 1-0 con opcode digit
digit 1 1
digit 2 12
digit 3 14
digit 4 145
digit 5 15
digit 6 124
digit 7 1245
digit 8 125
digit 9 24
digit 0 245

# Sistema Plus6 (Always attivo)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# Lo zero speciale (6 + 3456)
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
