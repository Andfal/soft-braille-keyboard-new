# Tabella IBRIDA Italiana v16 (STRUTTURA STANDARD)
# Dots: 6
# Descrizione: Sistema ibrido con Segnanumero (3456) e Plus6 diretto.
# Include lettere, accenti e punteggiatura italiana completa.

include unicode.dis
include text_nabcc.dis

# 1. DEFINIZIONI CARATTERI BASE
include latinLetterDef6Dots.uti

# 2. ACCENTI E CARATTERI SPECIALI ITALIANI
# Standard italiani
lowercase \x00E0 12356  # à
base uppercase \x00C0 \x00E0
lowercase \x00E8 2346   # è
base uppercase \x00C8 \x00E8
lowercase \x00E9 123456 # é
base uppercase \x00C9 \x00E9
lowercase \x00EC 34     # ì
base uppercase \x00CC \x00EC
lowercase \x00F2 346    # ò
base uppercase \x00D2 \x00F2
lowercase \x00F9 23456  # ù
base uppercase \x00D9 \x00F9

# Altri accenti (acuti, dieresi, circonflesse)
lowercase \x00E1 6-12356  # á
lowercase \x00E4 6-345    # ä
lowercase \x00ED 6-34     # í
lowercase \x00F3 6-346    # ó
lowercase \x00FA 6-23456  # ú
lowercase \x00E2 5-16     # â
lowercase \x00EA 5-126    # ê
lowercase \x00EE 5-146    # î
lowercase \x00F4 5-1456   # ô
lowercase \x00FB 5-156    # û
lowercase \x00EB 5-1246   # ë
lowercase \x00EF 5-12456  # ï
lowercase \x00FC 5-1256   # ü
lowercase \x00E7 6-12346  # ç
lowercase \x00F1 6-12456  # ñ
lowercase \x0153 5-246    # œ

# 3. PUNTEGGIATURA E SEGNI
punctuation ! 235
punctuation " 4
punctuation ' 3
punctuation ( 236
punctuation ) 356
punctuation , 2
punctuation . 256
punctuation : 25
punctuation ; 23
punctuation ? 26
punctuation [ 5-12356
punctuation ] 5-23456
punctuation { 5-12346
punctuation } 5-13456
punctuation \x00AB 5-236   # «
punctuation \x00BB 5-356   # »

sign # 5-3456
sign $ 5-46
sign % 5-123456
sign & 12346
sign @ 345
sign + 5-235
sign / 5-256
sign \x005C 56-6  # \
sign ^ 45-2346
sign _ 456
sign ~ 5-2346
sign | 5-34
sign \x20AC 5-15   # €
sign \x00A3 5-123  # £

math < 56
math = 2356
math > 45
math \x00D7 46-236  # ×
math \x00F7 46-256  # ÷

# 4. SISTEMA IBRIDO NUMERICO
numsign 3456

# A. Standard Segnanumero (attivo solo dopo 3456)
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

# B. Continuità Numerica (Impedisce interruzioni in 12,3 o 10:30)
midnum , 2
midnum . 256
midnum : 25
midnum - 36
midnum / 34

# C. Sistema 6dotplus (Digitazione diretta con punto 6)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# D. Zero Speciale (punto 6 + 3456)
always \x0030 6-3456

# 5. MAIUSCOLE E RIPETIZIONI
capsletter 46
begcapsword 46-46
endcapsword 46-3
repeated ___ 456-456-456
repeated --- 36-36-36

# 6. FINALE: BRAILLE PATTERNS E SPAZIO
space \x0020 0
space \x00a0 0
include braille-patterns.cti
