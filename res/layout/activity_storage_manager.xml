<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_setup_sync_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_setup_sync_folder"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edit_search_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_search_items"
        android:inputType="text"
        android:drawablePadding="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/text_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_tap_to_edit"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/list_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_create_new_table"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_create_new_table" />

        <Button
            android:id="@+id/btn_export_system_manager"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_export_system" />
    </LinearLayout>
</LinearLayout>
