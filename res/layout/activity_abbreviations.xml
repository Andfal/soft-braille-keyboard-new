<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_abbreviation_editor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_setup_folder_abbr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_setup_sync_folder"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/check_space_expansion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_enabled_title"
        android:textStyle="bold"
        android:layout_marginBottom="0dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_enabled_summary"
        android:textSize="12sp"
        android:layout_marginLeft="32dp"
        android:layout_marginBottom="12dp"/>

    <CheckBox
        android:id="@+id/check_instant_expansion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_instant_title"
        android:textStyle="bold"
        android:layout_marginBottom="0dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_instant_summary"
        android:textSize="12sp"
        android:layout_marginLeft="32dp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/check_add_space_expansion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_add_space_title"
        android:textStyle="bold"
        android:layout_marginBottom="0dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_abbreviations_add_space_summary"
        android:textSize="12sp"
        android:layout_marginLeft="32dp"
        android:layout_marginBottom="16dp"/>

    <ListView
        android:id="@+id/abbreviation_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/btn_export_abbr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_export"/>
            
        <Button
            android:id="@+id/btn_import_abbr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_import"/>
            
    </LinearLayout>

    <Button
        android:id="@+id/btn_add_abbreviation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_add"
        android:layout_marginTop="8dp"/>

</LinearLayout>
