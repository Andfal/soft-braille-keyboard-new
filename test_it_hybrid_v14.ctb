# Tabella IBRIDA Italiana v14 (Basata su Manuale)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# 1. DEFINIZIONI CARATTERI (Lettere e Accenti)
lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
lowercase \x00F2 346

# Includiamo la base
include it-it-comp6.utb

# 2. SISTEMA NUMERICO (Segnanumero)
numsign 3456
digit 1 1
digit 2 12
digit 3 14
digit 4 145
digit 5 15
digit 6 124
digit 7 1245
digit 8 125
digit 9 24
digit 0 245

# 3. CONTINUITÀ NUMERICA (Opcode dal manuale)
decpoint , 2
midnum . 256
midnum - 36
midnum : 25
numericmodechars ,.

# 4. SISTEMA PLUS6
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# 5. ZERO SPECIALE
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
