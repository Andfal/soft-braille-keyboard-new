# Tabella IBRIDA Italiana v7 (Test Manuale)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# 1. Lettere Standard (a-j)
# Definiamo le lettere esplicitamente per evitare conflitti con gli include
lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
include latinLetterDef6Dots.uti  # Per il resto dell'alfabeto (k-z)

# 2. Sistema Segnanumero (3456 + a-j)
numsign 3456
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

# 3. Sistema 6dotplus (Digitazione diretta con punto 6)
always \x0031 16          # 1
always \x0032 126         # 2
always \x0033 146         # 3
always \x0034 1456        # 4
always \x0035 156         # 5
always \x0036 1246        # 6
always \x0037 12456       # 7
always \x0038 1256        # 8
always \x0039 246         # 9

# 4. Lo zero SPECIALE (punto 6 + 3456)
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
