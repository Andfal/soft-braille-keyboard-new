# Custom Table for Soft Braille Keyboard
# Dots: 6
# Author: Gemini AI
#+locale: it

include braille-patterns.cti
include unicode.dis

# --- HIGH PRIORITY CUSTOM MAPPINGS ---
numsign 3456
begcapsword 456-456
space \x0020 0
lowercase \x0061 123456

# Base uppercase rules for this section
base uppercase \x0041 \x0061

# --- SYSTEM INCLUDES ---
include unicode.dis
include latinLetterDef6Dots.uti
include digits6Dots.uti
include litdigits6Dots.uti
numsign 3456

# --- STANDARD PRIORITY CUSTOM MAPPINGS ---
punctuation \x0021 235
math \x002b 235
sign \x0040 345
digit \x0031 1
word hello 125-15-123-123-135
partword ing 346
letsign 56
letter \x0078 1346
litdigit \x0031 1
midnum \x002c 2
punctuation \x002e 256
numericmodechars \x002e 256
math \x0023 3456
midendnumericmodechars \x0023 3456
begnum # 3456
endnum % 156
begcaps 46
endcaps 46
endcapsword 46
prepunc \x0028 2356
postpunc \x0029 2356

numericmodechars .
midendnumericmodechars #

# Base uppercase rules for this section
base uppercase \x0058 \x0078
