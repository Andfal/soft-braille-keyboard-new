# Tabella IBRIDA Italiana v17 (FIXED PRECEDENCE)
# Dots: 6

include unicode.dis

# 0. MASSIMA PRIORITA' RETRO-TRADUZIONE
# Mettiamo la Ã² qui per vincere sui digit interni di Liblouis
always \x00F2 346

# 1. LETTERE STANDARD (a-z)
lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
lowercase k 13
lowercase l 123
lowercase m 134
lowercase n 1345
lowercase o 135
lowercase p 1234
lowercase q 12345
lowercase r 1235
lowercase s 234
lowercase t 2345
lowercase u 136
lowercase v 1236
lowercase w 2456
lowercase x 1346
lowercase y 13456
lowercase z 1356

# 2. ACCENTI ITALIANI
lowercase \x00E0 12356  # Ã 
lowercase \x00E8 2346   # Ã¨
lowercase \x00E9 123456 # Ã©
lowercase \x00EC 34     # Ã¬
lowercase \x00F9 23456  # Ã¹

# 3. PUNTEGGIATURA E SIMBOLI
punctuation ! 235
punctuation " 4
punctuation ' 3
punctuation ( 236
punctuation ) 356
punctuation , 2
punctuation . 256
punctuation : 25
punctuation ; 23
punctuation ? 26
punctuation - 36
sign @ 345
sign # 5-3456
sign $ 5-46
sign % 5-123456
sign & 12346
sign + 5-235
sign / 5-256
sign \x20AC 5-15  # â‚¬

# 4. SISTEMA IBRIDO NUMERICO
numsign 3456
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

midnum , 2
midnum . 256
midnum : 25
midnum - 36
numericmodechars ,.:-

# 5. SISTEMA PLUS6
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# 6. ZERO SPECIALE
always \x0030 6-3456

# 7. MAIUSCOLE E SPAZIO
capsletter 46
begcapsword 46-46
endcapsword 46-3
space \x0020 0
space \x00a0 0
include braille-patterns.cti
