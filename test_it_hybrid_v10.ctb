# Tabella IBRIDA Italiana v10 (Validazione Finale)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# Lettere e Accenti (Priorità retro-traduzione)
lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
include latinLetterDef6Dots.uti

# Accenti Italiani (da it-it-comp6.utb)
lowercase \x00E0 12356  # à
lowercase \x00E8 2346   # è
lowercase \x00E9 123456 # é
lowercase \x00EC 34     # ì
lowercase \x00F2 346    # ò
lowercase \x00F9 23456  # ù

# Punteggiatura e Decimali
punctuation , 2
punctuation . 256
midnum , 2
midnum . 256

# Sistema Segnanumero
numsign 3456
digit 1 1
digit 2 12
digit 3 14
digit 4 145
digit 5 15
digit 6 124
digit 7 1245
digit 8 125
digit 9 24
digit 0 245

# Sistema Plus6 (Priorità Massima)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# Zero speciale (6 + 3456)
always \x0030 6-3456

space \x0020 0
space \x00a0 0
