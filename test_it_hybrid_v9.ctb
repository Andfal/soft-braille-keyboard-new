# Tabella IBRIDA Italiana v9 (Correzione Lettere + Decimali)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# 1. Definiamo le lettere SEMPLICI esplicitamente per proteggerle dai digit
lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
lowercase \x00F2 346  # ò (per evitare che diventi 9)

# 2. Carichiamo tutta la base italiana per gli accenti e il resto delle lettere
include it-it-comp6.utb

# 3. SISTEMA SEGNANUMERO (3456)
numsign 3456
# Usiamo litdigit che è più sicuro per il Braille letterario
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

# 4. GESTIONE NUMERI DECIMALI (12,3)
midnum , 2
midnum . 256

# 5. SISTEMA 6DOTPLUS (Digitazione diretta con punto 6)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# 6. ZERO SPECIALE (punto 6 + 3456)
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
