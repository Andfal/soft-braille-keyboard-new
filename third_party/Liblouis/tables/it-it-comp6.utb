# liblouis: Italiano
include text_nabcc.dis

#--------------------- All chars definitions ------------------------------

space \s 0 blank                                        # 32
space \t  5-5 #Tab  \x0009

punctuation ! 235                                               33
punctuation " 4                                         34
punctuation ' 3                                 39
punctuation ( 236                                       40
punctuation ) 356                                       41
punctuation *   35                                      42
punctuation , 2                                         44
punctuation - 36                                        45  the hyphen-minus
punctuation . 256                                               46
sign # 5-3456                                                           35
sign $ 5-46                                                                     36
sign % 5-123456                                                 37
sign & 12346                                                    38
sign + 5-235                                                            43
midnum + 235                                                    43
sign / 5-256                                                            47

lowercase \x00F2 346                  # o with grave above
base uppercase \x00D2 \x00F2
lowercase \x00F6 6-246                        # o with diaeresis
base uppercase \x00D6 \x00F6

digit        0      3456

include digits6DotsPlusDot6.uti

punctuation : 25                        colon                                   58              x003A     
punctuation ;   23                      semicolon                       59              x003B
