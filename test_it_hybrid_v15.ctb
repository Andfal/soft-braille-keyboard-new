# Tabella IBRIDA Italiana v15 (PULITA con Include)
# Dots: 6

include unicode.dis
include braille-patterns.cti

# 1. Carichiamo la base italiana completa (accenti, punteggiatura, lettere)
include it-it-comp6.utb

# 2. SISTEMA SEGNANUMERO (3456)
numsign 3456
# litdigit è la chiave per evitare che le lettere diventino numeri senza segnanumero
litdigit 1 1
litdigit 2 12
litdigit 3 14
litdigit 4 145
litdigit 5 15
litdigit 6 124
litdigit 7 1245
litdigit 8 125
litdigit 9 24
litdigit 0 245

# 3. CONTINUITÀ NUMERICA (Per 12,3 e 10.000)
midnum , 2
midnum . 256

# 4. SISTEMA 6DOTPLUS (Digitazione diretta con punto 6)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# 5. ZERO SPECIALE (6 + 3456)
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
