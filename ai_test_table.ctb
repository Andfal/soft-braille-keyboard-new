# Custom Table for Soft Braille Keyboard
# Dots: 6
#+locale: en

include braille-patterns.cti
include unicode.dis

# --- HIGH PRIORITY CUSTOM MAPPINGS ---
begcapsword 6-6
space \x0020 0

# --- SYSTEM INCLUDES ---
include unicode.dis
include latinLetterDef6Dots.uti
include digits6Dots.uti
include litdigits6Dots.uti
numsign 3456

# --- STANDARD PRIORITY CUSTOM MAPPINGS ---
lowercase \x0061 1
prepunc \x0028 2356
postpunc \x0029 2356

# Base uppercase rules for this section
base uppercase \x0041 \x0061
