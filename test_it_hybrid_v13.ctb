# Tabella IBRIDA Italiana v13
# Dots: 6

include unicode.dis
include braille-patterns.cti

# 1. BASE ITALIANA (Lettere, Accenti, Punteggiatura)
include it-it-comp6.utb

# 2. SISTEMA SEGNANUMERO
numsign 3456
include digits6Dots.uti

# 3. CONTINUITÀ NUMERICA (Correzione per virgola italiana)
midnum , 2
midnum . 256

# 4. SISTEMA PLUS6 (Sempre attivo)
always \x0031 16
always \x0032 126
always \x0033 146
always \x0034 1456
always \x0035 156
always \x0036 1246
always \x0037 12456
always \x0038 1256
always \x0039 246

# 5. ZERO SPECIALE (6 + 3456)
always \x0030 6-3456

# Spazio
space \x0020 0
space \x00a0 0
