<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference android:title="@string/voice_helper_setting_title" android:key="@string/voice_helper_setting">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.VoiceHelperSetting" />
    </Preference>
    <PreferenceScreen android:title="@string/ocr_setting">
        <CheckBoxPreference android:title="@string/use_virtual_screen_dim_background_title" android:key="@string/use_virtual_screen_dim_background" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_ocr_auto_speak_title" android:key="@string/use_ocr_auto_speak" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_ocr_title" android:key="@string/use_ocr" android:summary="@string/use_ocr_summary" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_image_to_text_title" android:key="@string/use_image_to_text" android:defaultValue="false" />
        <ListPreference android:entries="@array/tts_scale_values" android:title="@string/ocr_engine_title" android:key="@string/ocr_engine" android:defaultValue="6" android:entryValues="@array/tts_scale_values" />
        <ListPreference android:entries="@array/tts_scale_values" android:title="@string/ocr_lang_title" android:key="@string/ocr_lang" android:summary="@string/ocr_lang_summary" android:defaultValue="auto" android:entryValues="@array/tts_scale_values" />
        <ListPreference android:entries="@array/tts_scale_values" android:title="@string/ocr_level_title" android:key="@string/ocr_level" android:defaultValue="5" android:entryValues="@array/tts_scale_values" />
        <Preference android:title="@string/ocr_clean_keyword_title" android:key="@string/ocr_clean_keyword" android:summary="@string/ocr_clean_keyword_summary" />
        <ListPreference android:title="@string/ocr_portrait_mode_title" android:key="@string/ocr_portrait_mode" android:defaultValue="-1" />
        <ListPreference android:title="@string/ocr_landscape_mode_title" android:key="@string/ocr_landscape_mode" android:defaultValue="-1" />
        <PreferenceScreen android:title="@string/ocr_baidu_setting" android:summary="@string/ocr_baidu_summary">
            <EditTextPreference android:title="@string/ocr_baidu_id_title" android:key="@string/ocr_baidu_id" />
            <EditTextPreference android:title="@string/ocr_baidu_key_title" android:key="@string/ocr_baidu_key" />
            <EditTextPreference android:title="@string/ocr_baidu_secret_title" android:key="@string/ocr_baidu_secret" />
            <Preference android:summary="@string/use_ocr_baidu_help">
                <intent android:action="android.intent.action.VIEW" android:data="https://ai.baidu.com" />
            </Preference>
        </PreferenceScreen>
        <Preference android:title="@string/edit_ocr_lua_title" android:key="edit_ocr_lua" />
    </PreferenceScreen>
    <Preference android:title="@string/timer_setting_title" android:key="@string/timer_setting">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.TimerSetting" />
    </Preference>
    <PreferenceScreen android:title="@string/action_settings_title">
        <CheckBoxPreference android:title="@string/keep_focus_position_title" android:key="@string/keep_focus_position" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/keep_focus_position_speak_title" android:key="@string/keep_focus_position_speak" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/auto_focus_title" android:key="@string/auto_focus" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_navigation_gesture_title" android:key="@string/use_navigation_gesture" android:summary="@string/use_navigation_gesture_summary" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_proximity_false_touch_prevention_title" android:key="@string/use_proximity_false_touch_prevention" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_proximity_false_touch_prevention_only_lock_title" android:key="@string/use_proximity_false_touch_prevention_only_lock" android:dependency="@string/use_proximity_false_touch_prevention" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/only_notification_title" android:key="@string/only_notification" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/resume_on_screen_on_title" android:key="@string/resume_on_screen_on" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/resume_on_screen_off_title" android:key="@string/resume_on_screen_off" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/resume_on_notification_show_title" android:key="@string/resume_on_notification_show" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/resume_on_ringing_title" android:key="@string/resume_on_ringing" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_touch_mode_title" android:key="@string/use_touch_mode" android:defaultValue="true" />
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/input_setting_title">
        <CheckBoxPreference android:title="@string/use_input_method_gesture_title" android:key="@string/use_input_method_gesture" android:summary="@string/use_input_method_gesture_summary" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_input_method_no_touch_title" android:key="@string/use_input_method_no_touch" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_input_method_no_gesture_title" android:key="@string/use_input_method_no_gesture" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_input_method_double_tap_title" android:key="@string/use_input_method_double_tap" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_key_title" android:key="@string/use_input_method_speak_key" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_upper_speak_title" android:key="@string/use_pinyin_speak" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_word_title" android:key="@string/use_input_method_speak_word" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_candidate_title" android:key="@string/use_input_method_speak_candidate" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_commit_title" android:key="@string/use_input_method_speak_commit" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_commit_space_title" android:key="@string/use_input_method_speak_commit_space" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/use_input_method_speak_password_title" android:key="@string/use_input_method_speak_password" android:defaultValue="true" />
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/menu_settings_title">
        <CheckBoxPreference android:title="@string/use_multi_menu_title" android:key="@string/use_multi_menu" android:defaultValue="false" />
        <Preference android:title="@string/main_menu_items_title" android:key="@string/main_menu_items" />
        <Preference android:title="@string/multi_menu_items_title" android:key="@string/multi_menu_items" />
        <CheckBoxPreference android:title="@string/use_float_menu_title" android:key="@string/use_float_menu" android:defaultValue="false" />
        <Preference android:title="@string/float_menu_items_title" android:key="@string/float_menu_items" />
        <CheckBoxPreference android:title="@string/use_action_menu_show_cursor_title" android:key="@string/use_action_menu_show_cursor" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_action_menu_show_ext_title" android:key="@string/use_action_menu_show_ext" android:defaultValue="false" />
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/read_mode_setting">
        <Preference android:title="@string/next_chapter_title" android:key="@string/next_chapter" />
        <Preference android:title="@string/previous_chapter_title" android:key="@string/previous_chapter" />
    </PreferenceScreen>
    <MultiSelectListPreference android:title="@string/setup_plugin_title" android:key="@string/setup_plugin" />
    <Preference android:title="@string/timer_run_title">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.TimerRun" />
    </Preference>
    <Preference android:title="@string/profiles_title" android:key="@string/profiles" android:summary="@string/profiles_summary" android:defaultValue="" />
    <Preference android:title="@string/manager_activity_title" android:key="@string/manager">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.ManagerActivity" />
    </Preference>
    <PreferenceScreen android:title="@string/backup_restore_settings_title">
        <Preference android:title="@string/backup_settings_title" android:key="@string/backup_settings" />
        <Preference android:title="@string/restore_settings_title" android:key="@string/restore_settings" />
        <Preference android:title="@string/cloud_multi_backup_title" android:key="@string/cloud_multi_backup" />
        <Preference android:title="@string/cloud_multi_restore_title" android:key="@string/cloud_multi_restore" />
        <Preference android:title="@string/export_all_file" android:key="export_all_file" />
    </PreferenceScreen>
    <Preference android:title="@string/language_setting_title">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.LanguageSetting" />
    </Preference>
    <PreferenceScreen android:title="@string/power_settings_title">
        <CheckBoxPreference android:title="@string/use_power_save_title" android:key="@string/use_power_save" android:summary="@string/use_power_save_summary" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/use_foreground_title" android:key="@string/use_foreground" android:summary="@string/use_foreground_summary" android:defaultValue="false" />
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/other_setting">
        <CheckBoxPreference android:title="@string/use_auto_update_title" android:key="@string/use_auto_update" android:defaultValue="false" />
        <Preference android:title="@string/show_download_title" android:key="@string/show_download">
            <intent android:targetPackage="com.nirenr.talkman" android:data="https://d.jieshuo.ltd" android:targetClass="com.nirenr.talkman.WebActivity" />
        </Preference>
        <CheckBoxPreference android:title="@string/use_show_text_title" android:key="@string/use_show_text" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/user_letter_map_title" android:key="@string/user_letter_map" android:defaultValue="false" />
        <EditTextPreference android:title="@string/split_row_keyword_title" android:key="@string/split_row_keyword" android:summary="@string/split_row_keyword_summary" android:defaultValue="" />
        <CheckBoxPreference android:title="@string/use_split_line_title" android:key="@string/use_split_line" android:defaultValue="false" />
        <Preference android:title="@string/accessibility_focus_appearance_title" android:key="@string/accessibility_focus_appearance" />
        <CheckBoxPreference android:title="@string/use_dim_screen_title" android:key="@string/use_dim_screen" android:defaultValue="false" />
    </PreferenceScreen>
</PreferenceScreen>
