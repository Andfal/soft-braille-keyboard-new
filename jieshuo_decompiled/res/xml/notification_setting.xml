<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ListPreference android:title="@string/notification_bar_speak_title" android:key="@string/notification_speak2" android:defaultValue="1" />
    <CheckBoxPreference android:title="@string/notification_toast_speak_title" android:key="@string/notification_toast_speak" android:defaultValue="true" />
    <CheckBoxPreference android:title="@string/notification_announcement_speak_title" android:key="@string/notification_announcement_speak" android:defaultValue="true" />
    <CheckBoxPreference android:title="@string/notification_in_touch_no_speak_title" android:key="@string/notification_in_touch_no_speak" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/notification_in_call_no_speak_title" android:key="@string/notification_in_call_no_speak" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/notification_in_auto_read_no_speak_title" android:key="@string/notification_in_auto_read_no_speak" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/notification_summary_title" android:key="@string/notification_summary" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/notification_app_name_speak_title" android:key="@string/notification_app_name_speak" android:defaultValue="true" />
    <Preference android:title="@string/notification_black_list_title" android:key="@string/notification_black_list" android:summary="@string/notification_black_list_summary" />
    <Preference android:title="@string/notification_white_list_title" android:key="@string/notification_white_list" android:summary="@string/notification_white_list_summary" />
    <Preference android:title="@string/notification_tts_setting_title">
        <intent android:targetPackage="com.nirenr.talkman" android:action="@string/notification_tts_setting_title" android:data="1" android:targetClass="com.nirenr.talkman.settings.TimerTtsSetting" />
    </Preference>
</PreferenceScreen>
