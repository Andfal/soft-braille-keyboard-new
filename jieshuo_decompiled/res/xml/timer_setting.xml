<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference android:title="@string/timer_tts_setting_title">
        <intent android:targetPackage="com.nirenr.talkman" android:action="@string/timer_tts_setting_title" android:targetClass="com.nirenr.talkman.settings.TimerTtsSetting" />
    </Preference>
    <CheckBoxPreference android:title="@string/use_alarm_title" android:key="@string/use_alarm" android:summary="@string/use_alarm_summary" android:defaultValue="false" />
    <ListPreference android:entries="@array/alarm_interval_entries" android:title="@string/alarm_interval_title" android:key="@string/alarm_interval" android:dependency="@string/use_alarm" android:defaultValue="15" android:entryValues="@array/alarm_interval_values" />
    <MultiSelectListPreference android:entries="@array/alarm_hour_values" android:title="@string/alarm_hours_title" android:key="@string/alarm_hours" android:dependency="@string/use_alarm" android:entryValues="@array/alarm_hour_values" />
    <CheckBoxPreference android:title="@string/use_timer_speak_title" android:key="@string/use_timer_speak" android:defaultValue="true" />
    <ListPreference android:entries="@array/timer_interval_entries" android:title="@string/timer_interval_title" android:key="@string/timer_interval" android:defaultValue="10" android:entryValues="@array/timer_interval_values" />
    <CheckBoxPreference android:title="@string/use_timer_vibrate_title" android:key="@string/use_timer_vibrate" android:defaultValue="true" />
    <CheckBoxPreference android:title="@string/use_timer_sound_title" android:key="@string/use_timer_sound" android:defaultValue="true" />
    <Preference android:title="@string/timer_manager_title" android:key="@string/timer_manager" />
    <Preference android:title="@string/timer_tags_items_title" android:key="@string/timer_tags_items" />
    <Preference android:title="@string/timer_items_title" android:key="@string/timer_items" />
    <ListPreference android:title="@string/timer_action_def_title" android:key="@string/timer_action_def" android:summary="@string/timer_action_def_summary" android:defaultValue="" />
</PreferenceScreen>
