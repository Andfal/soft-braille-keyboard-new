<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <CheckBoxPreference android:title="@string/use_sound_title" android:key="@string/use_sound" android:defaultValue="true" />
    <ListPreference android:entries="@array/tts_values" android:title="@string/sound_volume_title" android:key="@string/sound_volume" android:defaultValue="60" android:entryValues="@array/tts_values" />
    <ListPreference android:enabled="false" android:title="@string/sound_package_title" android:key="@string/sound_package" android:defaultValue="@string/value_default" />
    <MultiSelectListPreference android:title="@string/app_no_supper_sound_package_title" android:key="@string/app_no_supper_sound_package" />
    <Preference android:title="@string/sound_settings_title" android:key="@string/custom_sound_settings" />
    <Preference android:title="@string/sound_manager_title" android:key="@string/sound_manager" />
    <Preference android:title="@string/download_sound_package_title" android:key="@string/download_sound_package" />
    <CheckBoxPreference android:title="@string/vibrate_title" android:key="@string/use_vibrate" android:defaultValue="true" />
    <ListPreference android:entries="@array/vibrate_intensity_entries" android:title="@string/vibrate_intensity_title" android:key="@string/vibrate_intensity" android:defaultValue="32" android:entryValues="@array/vibrate_intensity_values" />
</PreferenceScreen>
