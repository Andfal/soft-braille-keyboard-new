<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference android:title="@string/chat_history">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.ChatActivity" />
    </Preference>
    <CheckBoxPreference android:title="@string/voice_helper_use_input_method_title" android:key="@string/voice_helper_use_input_method" android:defaultValue="false" />
    <ListPreference android:entries="@array/recognizer_lang_entries" android:title="@string/recognizer_lang_title" android:key="@string/recognizer_lang" android:defaultValue="zh_CN" android:entryValues="@array/recognizer_lang_values" />
    <ListPreference android:title="@string/voice_recognizer_title" android:key="@string/system_voice_recognizer" android:defaultValue="default" />
    <Preference android:title="@string/voice_cmd_setting_title" android:key="@string/voice_cmd_setting" />
    <Preference android:title="@string/helper_supper_cmd_title">
        <intent android:targetPackage="com.nirenr.talkman" android:targetClass="com.nirenr.talkman.settings.VoiceSupperCmdManager" />
    </Preference>
    <PreferenceScreen android:title="@string/voice_helper_capability_setting">
        <CheckBoxPreference android:title="@string/voice_helper_use_gestures_title" android:key="@string/voice_helper_use_gestures" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_app_gestures_title" android:key="@string/voice_helper_use_app_gestures" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_cmd_title" android:key="@string/voice_helper_use_cmd" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_supper_cmd_title" android:key="@string/voice_helper_use_supper_cmd" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_plugin_title" android:key="@string/voice_helper_use_plugin" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_tool_title" android:key="@string/voice_helper_use_tool" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_click_title" android:key="@string/voice_helper_use_click" android:summary="@string/voice_helper_use_click_summary" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_app_title" android:key="@string/voice_helper_use_app" android:summary="@string/voice_helper_use_app_summary" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_blot_title" android:key="@string/voice_helper_use_blot" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/voice_helper_use_big_title" android:key="@string/voice_helper_use_big" android:dependency="@string/voice_helper_use_blot" android:defaultValue="false" />
    </PreferenceScreen>
    <CheckBoxPreference android:title="@string/voice_helper_copy_title" android:key="@string/voice_helper_copy" android:defaultValue="true" />
    <ListPreference android:entries="@array/lang_entries" android:title="@string/trans_lang_from_title" android:key="@string/trans_lang_from" android:defaultValue="@string/auto" android:entryValues="@array/lang_values" />
    <ListPreference android:entries="@array/lang_entries" android:title="@string/trans_lang_to_title" android:key="@string/trans_lang_to" android:defaultValue="zh" android:entryValues="@array/lang_values" />
    <CheckBoxPreference android:title="@string/trans_lua_engine_title" android:key="@string/trans_lua_engine" android:defaultValue="false" />
    <Preference android:title="@string/edit_trans_lua_title" android:key="@string/edit_trans_lua" />
    <ListPreference android:title="@string/search_engine_title" android:key="@string/search_engine" android:defaultValue="https://bing.com/search?q=" />
    <EditTextPreference android:title="@string/custom_search_engine_title" android:key="@string/custom_search_engine" android:defaultValue="https://bing.com/search?q=" />
    <CheckBoxPreference android:title="@string/use_long_click_voice_input_title" android:key="@string/use_long_click_voice_input" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/voice_input_append_mode_title" android:key="@string/voice_input_append_mode" android:defaultValue="true" />
    <CheckBoxPreference android:title="@string/use_long_click_voice_image_title" android:key="@string/use_long_click_voice_image" android:defaultValue="false" />
    <CheckBoxPreference android:title="@string/voice_helper_media_mute_mode_title" android:key="@string/voice_helper_media_mute_mode" android:defaultValue="false" />
</PreferenceScreen>
